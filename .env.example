# Netflix Portfolio - Environment Variables
# Copy this file to .env.local and fill in your values

# Contact Form API Endpoint (for production)
# Set this in Amplify Console environment variables
VITE_CONTACT_API_URL=https://api.example.com/contact

# Optional: Analytics
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=vaibhava-shrivastav.vercel.app

# Optional: Feature flags
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_TERMINAL=true